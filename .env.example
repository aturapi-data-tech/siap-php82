# ── Aplikasi ──
APP_NAME="SIAP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE='Asia/Jakarta'

# ── Log ──
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database Oracle ──
DB_CONNECTION=oracle
DB_HOST=
DB_PORT=1521
DB_SERVICE_NAME=orcl
DB_LOAD_BALANCE=no
DB_EDITION=null
DB_DATABASE=siap
DB_USERNAME=siap
DB_PASSWORD=
ORA_MAX_NAME_LEN=30 # Oracle 10g: nama objek maks 30 karakter

# ── Session / Cache / Queue ──
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_DRIVER=database
QUEUE_CONNECTION=sync
BROADCAST_DRIVER=log
FILESYSTEM_DISK=public

# ── Identitas RS ──
RS_PHONE="03553491131"
RS_EMAIL="rsimadinah@gmail.com"
RS_WEBSITE="http://rsimadinah.com"
RS_ALAMAT="V2P7+PJ Ngunut, Tulungagung Regency, East Java"
RS_KOTA="TULUNGAGUNG"
RS_KODEPOS="66292"
RS_LATITUDE=-8.113060848639664
RS_LONGITUDE=112.01405173771573

# ── Redis / Memcached ──
MEMCACHED_HOST=127.0.0.1
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

# ── Mail ──
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ── Identitas kop cetakan (config/identitas.php) ──
IDENTITAS_NAMA="KLINIK MADINAH PRATAMA"
IDENTITAS_ALAMAT="Jl. Raya Demuk-Kalangan, Kalangan, Kec. Ngunut, Kabupaten Tulungagung, Jawa Timur 66292"
IDENTITAS_TELP=
IDENTITAS_FAX=
IDENTITAS_WEBSITE=
IDENTITAS_LOGO="images/Logo Klinik Madinah Pratama horizontal.png"
IDENTITAS_KOTA="Tulungagung"
